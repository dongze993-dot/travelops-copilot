# Copy this file to .env for local development. .env is Git-ignored.
# Never commit, paste into chat, or show DEEPSEEK_API_KEY in screenshots.
DEEPSEEK_API_KEY=

# v1 stays deterministic. v2 only sends a bounded, synthetic candidate to the
# provider when this is true and the key/model configuration is valid.
TRAVELOPS_LLM_ENABLED=false
TRAVELOPS_LLM_PROVIDER=deepseek
TRAVELOPS_LLM_BASE_URL=https://api.deepseek.com

# Confirm the model identifier in your own DeepSeek API console before enabling.
TRAVELOPS_LLM_MODEL=deepseek-chat
TRAVELOPS_LLM_TIMEOUT_SECONDS=20
TRAVELOPS_LLM_MAX_RETRIES=1
TRAVELOPS_LLM_MAX_TOKENS=800
TRAVELOPS_LLM_TEMPERATURE=0

# Set true only for a public host. It disables all mock-CRM ticket reads and
# writes, so the demo remains stateless and should not receive personal data.
TRAVELOPS_PUBLIC_DEMO_MODE=false

# Optional: place the local mock-CRM SQLite database somewhere else.
# TRAVELOPS_DB_PATH=runtime/travelops_mock_crm.db
